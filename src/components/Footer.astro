---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Logo height={26} />
      <p class="claim">The time to ACT! is now</p>
    </div>
    <div class="footer-meta">
      <p>ACT! IT GmbH · Aschaffenburg · deutschlandweit, hauptsächlich remote</p>
      <p><a data-user="arhauvr" data-domain="bl.ap-ajh" href="#" data-rybbit-event="kontakt" data-rybbit-prop-art="mail">Kontakt siehe Impressum</a></p>
    </div>
    <ul class="footer-links">
      <li><a href="/impressum/">Impressum</a></li>
      <li><a href="/datenschutz/">Datenschutzerklärung</a></li>
    </ul>
  </div>
  <div class="container copy num">© {year} ACT! IT GmbH</div>
</footer>
<style>
  .site-footer { background: var(--ink); color: var(--paper); padding: 56px var(--gutter) 28px; margin-top: var(--section-pad); }
  .footer-grid { display: grid; grid-template-columns: 1.2fr 1.4fr .8fr; gap: 32px; align-items: start; }
  .site-footer p { color: color-mix(in srgb, var(--paper) 78%, var(--ink)); margin: 0 0 .4em; max-width: none; }
  .claim { font-family: var(--font-display); font-size: .95rem; letter-spacing: .02em; margin-top: 10px !important; }
  .site-footer a { color: var(--paper); }
  .footer-links { list-style: none; margin: 0; padding: 0; display: flex; gap: 20px; justify-content: flex-end; }
  .copy { margin-top: 36px; padding-top: 18px; border-top: 1px solid color-mix(in srgb, var(--paper) 18%, var(--ink)); font-size: var(--fs-small); color: color-mix(in srgb, var(--paper) 70%, var(--ink)); }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr; } .footer-links { justify-content: flex-start; } }
</style>
