---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const items = [
  { href: '/excel-und-access-abloesen/', label: 'Excel und Access ablösen' },
  { href: '/oracle-apex/', label: 'Oracle APEX' },
  { href: '/blog/', label: 'Blog' },
  { href: '/#team', label: 'Team' },
];
---
<header class="site-header">
  <nav class="nav container" aria-label="Hauptnavigation">
    <a class="nav-logo" href="/" aria-label="ACT! IT GmbH, zur Startseite"><Logo height={28} /></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menü"><span></span><span></span></button>
    <ul class="nav-menu" id="nav-menu">
      {items.map((it) => <li><a href={it.href} aria-current={path === it.href ? 'page' : undefined}>{it.label}</a></li>)}
      <li><a class="btn nav-cta" href="/#kontakt" data-rybbit-event="cta" data-rybbit-prop-ort="nav" data-rybbit-prop-ziel="kontakt">Anfrage senden</a></li>
    </ul>
  </nav>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rail-faint); }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 24px; padding-inline: var(--gutter); }
  .nav-logo { display: inline-flex; }
  .nav-menu { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 28px; }
  .nav-menu a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 500; font-size: .98rem; padding: 6px 0; border-bottom: 2px solid transparent; }
  .nav-menu a:not(.btn):hover, .nav-menu a[aria-current="page"] { border-bottom-color: var(--teal); }
  .nav-cta { padding: .6em 1.2em; font-size: .98rem; }
  .nav-toggle { display: none; width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; flex-direction: column; justify-content: center; gap: 7px; align-items: center; }
  .nav-toggle span { display: block; width: 24px; height: 2px; background: var(--ink); transition: transform 200ms var(--ease-out); }
  @media (max-width: 820px) {
    .nav-toggle { display: flex; }
    .nav-menu { display: none; position: absolute; left: 0; right: 0; top: 72px; flex-direction: column; align-items: stretch; gap: 0; background: var(--paper); border-bottom: 1px solid var(--rail-faint); padding: 8px var(--gutter) 16px; }
    .nav-menu.open { display: flex; }
    .nav-menu li { border-top: 1px solid var(--rail-faint); }
    .nav-menu a:not(.btn) { display: block; padding: 14px 0; border-bottom: 0; }
    .nav-menu .nav-cta { margin-top: 12px; justify-content: center; }
    .nav-toggle[aria-expanded="true"] span:first-child { transform: translateY(4.5px) rotate(45deg); }
    .nav-toggle[aria-expanded="true"] span:last-child { transform: translateY(-4.5px) rotate(-45deg); }
  }
</style>
